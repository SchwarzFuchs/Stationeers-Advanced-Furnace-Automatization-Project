alias DialRecipe d0
alias TemperaturePrioritySwitch d1
alias HotTank d2
alias StartButton d3
alias Sorter d4
bdns Sorter afterSorter
    s d4 Mode 1 # Any
    s d4 On 1
    clr d4
    sll r0 SortingClass.Ores 16
    sll r1 Equals 8
    or r0 r0 r1
    or r0 r0 SorterInstruction.FilterSortingClassCompare
    put d4 0 r0
afterSorter:
var TargetTemp
var TargetPressure
var RecipeHash
var DialReserveSetting
clr db
DialRecipe.Mode = 9
sp = 0
push -654790771 #steel
push 902
push 99998
push 1020
push -82508479 #solder
push 401
push 548
push 1020
push -297990285 #invar
push 1202
push 1498
push 18020
push 502280180 #electrum
push 602
push 99998
push 820
push 1058547521 #Constantin
push 1002
push 99998
push 20020
push -787796599 #inconel
push 602
push 99998
push 23520
push 156348098 #waspaloy #min T increased to prevent pollutant and N2O liquification
push 435
push 798
push 50050
push -1897868623 #stellite
push 1802
push 99998
push 10020
push 412924554 #astroloy
push 1002
push 99998
push 30030
push 1579842814 #hasteloy
push 952
push 998
push 25020
AfterStack:
l r10 d3 Lock
brne r10 1 3
l r11 d0 Setting
l r10 d3 Lock
brne r10 1 3
s d0 Setting r11
jr -3
var DialRecipeSetting = DialRecipe.Setting
var Priority = TemperaturePrioritySwitch.Setting
var HotTemp = HotTank.Temperature
HotTemp = HotTemp - 0.1
sp = DialRecipeSetting * 4 + 4
pop TargetPressure
breq Priority 0 6
pop TargetTemp
brle TargetTemp HotTemp 2
TargetTemp = HotTemp
sp = sp - 1
jr 3
sp = sp - 1
pop TargetTemp
pop RecipeHash
db.Setting = RecipeHash
sbn -851746783 -1941351525 Setting TargetTemp
sbn -851746783 -823947099 Setting TargetPressure
sbn -851746783 -74186795 Setting RecipeHash
j AfterStack